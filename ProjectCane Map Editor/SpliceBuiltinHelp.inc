// Names/order checked against g_mpbifkbif in ProjectCane eval.cpp.
// [optional] and ... are reference notation, not literal Splice syntax.
{"+", "(+ first [value ...])", "Adds numbers or supported compound values. Keep operand types compatible; vector addition is componentwise."},
{"-", "(- first [value ...])", "Subtracts following values from the first. In the supplied native implementation, a single operand is returned unchanged; use (- 0 value) for numeric negation."},
{"*", "(* first [value ...])", "Multiplies supported numbers, vectors, matrices and scalar/compound combinations. Operand order matters for matrices."},
{"/", "(/ first [value ...])", "Divides numeric values or supported compounds by scalar divisors. Avoid zero divisors."},
{"print", "(print value)", "Debug-print hook. The supplied ProjectCane implementation returns void without printing; do not depend on visible output."},
{"print-frame", "(print-frame [value ...])", "Frame debug hook. The supplied ProjectCane implementation returns void without output."},
{"print-sidebag", "(print-sidebag object)", "Object sidebag debug hook. The supplied ProjectCane implementation returns void without output."},
{"=", "(= a b)", "Compares values after signed-integer coercion. Floating fractions are discarded; this is not floating-point equality."},
{"<", "(< a b)", "Returns whether a is less than b after numeric float coercion."},
{"<=", "(<= a b)", "Returns whether a is less than or equal to b after numeric float coercion."},
{">", "(> a b)", "Returns whether a is greater than b after numeric float coercion."},
{">=", "(>= a b)", "Returns whether a is greater than or equal to b after numeric float coercion."},
{"eqv?", "(eqv? a b)", "Compares equal-tag values using native identity/value rules. Integers, booleans and symbols compare payloads; pairs compare identity. Floats and compound values have no value-equality case."},
{"equal?", "(equal? a b)", "Recursively compares pair contents using native equality rules. This does not add floating-point or compound numeric equality."},
{"boolean?", "(boolean? value)", "Tests for a Boolean value; does not coerce numbers."},
{"number?", "(number? value)", "Tests for an integer or floating-point value."},
{"integer?", "(integer? value)", "Tests the integer tag, rather than whether a float has a whole-number value."},
{"float?", "(float? value)", "Tests the floating-point tag."},
{"symbol?", "(symbol? value)", "Tests for a symbol value. Use (quote $name) to test a symbol without evaluating its binding."},
{"vector?", "(vector? value)", "Tests for a vector value."},
{"matrix?", "(matrix? value)", "Tests for a matrix value."},
{"clq?", "(clq? value)", "Tests for a constant/linear/quadratic coefficient value."},
{"lm?", "(lm? value)", "Tests for a minimum/maximum limits value."},
{"smp?", "(smp? value)", "Tests for a slow/fast smoothing-parameter value."},
{"list?", "(list? value)", "Accepts pair, None and Nil tags. It does not verify that an arbitrary pair chain is acyclic."},
{"null?", "(null? value)", "Tests for None, Nil or a pair containing a null pair pointer. A null object is a separate value; use null-obj?."},
{"object?", "(object? value)", "Tests the object tag, including object#0. It does not prove that the object pointer is non-null."},
{"null-obj?", "(null-obj? value)", "Returns true only for an object-tagged value with a null pointer. Use it to check a failed find-object result."},
{"method?", "(method? value)", "Tests for a native method, such as a callable returned by geto."},
{"procedure?", "(procedure? value)", "Tests for a lambda procedure, built-in or native method."},
{"near?", "(near? a b epsilon)", "Compares two numbers with the native FloatsNear tolerance test. Supply a nonnegative tolerance."},
{"not", "(not value)", "Returns true only when value is Boolean false. Numeric zero, Nil and null objects are not Boolean false."},
{"cons", "(cons value tail)", "Creates a pair whose first element is value and whose next chain comes from a pair tail. Use list for ordinary list construction."},
{"car", "(car items)", "Returns the first element of a nonempty pair list; an invalid/empty input yields None."},
{"cdr", "(cdr items)", "Returns the remaining pair chain after the first element."},
{"set-car!", "(set-car! items value)", "Mutates the first element of an existing pair. Other references to that pair see the change."},
{"set-cdr!", "(set-cdr! items tail)", "Changes an existing pair's next chain. Shared lists are affected; do not introduce cycles."},
{"length", "(length items)", "Counts the nodes in a pair list. Use only finite, acyclic lists."},
{"nth", "(nth items index)", "Returns the element at a zero-based index. Negative or out-of-range indexes yield None."},
{"member?", "(member? value items)", "Tests membership using CRef::operator==, which requires matching tags and compares floats and compound components exactly. This differs from eqv?/equal?; pair elements compare identity."},
{"list", "(list [value ...])", "Returns the evaluated argument list packed by the native variadic evaluator, preserving its pair identity. With no arguments, returns None as the empty list."},
{"append", "(append [items ...])", "Copies the elements of the supplied pair lists into a new list."},
{"map", "(map procedure items)", "Calls procedure once per element and returns a list of results. Example: (map (lambda ($x) (+ $x 1)) (list 1 2))."},
{"filter", "(filter procedure items)", "Returns elements whose predicate result is not Boolean false. Numeric zero does not reject an element."},
{"for-each", "(for-each procedure items)", "Calls procedure for each element for its side effects and returns void."},
{"eval", "(eval expression)", "Evaluates expression data in the current frame. Example: (eval (quote (+ 1 2))). Quoted code can therefore become executable later."},
{"vector", "(vector x y z)", "Constructs a three-component vector from numeric values. Example: (vector 0.0 0.0 100.0)."},
{"matrix", "(matrix [component ...])", "Constructs a matrix from 9 scalars, 16 scalars, or 3/4 vector columns. Other counts leave identity. Numeric storage follows ProjectCane/GLM indexing, not a text row-major convention."},
{"clq", "(clq constant linear quadratic)", "Constructs coefficients for constant + x * (linear + x * quadratic). Example: (clq 0.0 1.0 0.0)."},
{"lm", "(lm minimum maximum)", "Constructs numeric limits. Keep minimum <= maximum. Example: (lm 0.0 1.0)."},
{"smp", "(smp slow fast fast-time)", "Constructs SMP fields svSlow, svFast and dtFast. The operation consuming the SMP determines how those smoothing parameters are used."},
{"get-element", "(get-element compound index [second-index])", "Reads a zero-based component of a vector, CLQ, LM or SMP. For matrices, one index returns a three-component column; two indexes read matrix[first][second]. Invalid indexes yield None."},
{"random-seed", "(random-seed integer)", "Seeds the game's shared random generator. This affects later game random draws, not just this module."},
{"random", "(random low high)", "Returns a random float through GRandInRange. The registered built-in requires both bounds."},
{"sqrt", "(sqrt value)", "Returns the floating square root. Supply a nonnegative value; the native implementation does not clamp the domain."},
{"sin", "(sin radians)", "Returns sine; the angle is in radians."},
{"cos", "(cos radians)", "Returns cosine; the angle is in radians."},
{"tan", "(tan radians)", "Returns tangent; avoid its singular angles."},
{"asin", "(asin value)", "Returns arcsine in radians. Keep value in [-1, 1]; no domain clamp is applied."},
{"acos", "(acos value)", "Returns arccosine in radians. Keep value in [-1, 1]; no domain clamp is applied."},
{"atan", "(atan value)", "Returns arctangent in radians."},
{"rad-normalize", "(rad-normalize radians)", "Wraps an angle by multiples of 2*pi into the native [-pi, pi] interval. Supply finite angles."},
{"atan2", "(atan2 y x)", "Returns the signed angle in radians using both components."},
{"vector-dot-product", "(vector-dot-product a b)", "Returns the scalar dot product of two vectors."},
{"vector-cross-product", "(vector-cross-product a b)", "Returns the cross product a x b. Reversing operands reverses its direction."},
{"vector-lth", "(vector-lth value)", "Returns a vector's length."},
{"vector-distance", "(vector-distance a [b])", "Returns distance between two vectors; b defaults to the origin."},
{"vector-distance-squared", "(vector-distance-squared a [b])", "Returns squared distance, avoiding a square root. b defaults to the origin."},
{"vector-normalize", "(vector-normalize value [fallback])", "Returns a unit vector when length is at least 0.0001. For shorter vectors, uses the supplied fallback or a zero vector."},
{"vector-project-normal", "(vector-project-normal value normal)", "Returns the component along normal using normal * dot(value, normal). Supply a unit normal."},
{"vector-project-tangent", "(vector-project-tangent value normal)", "Removes the component along normal. Supply a unit normal."},
{"vector-ballistic-velocity", "(vector-ballistic-velocity launch target speed [launch-object])", "Calls FCalculateMuzzleVelocity for a ballistic launch vector. Optional launch-object must be SO-derived. Failure returns a zero vector."},
{"vector-radian-normal", "(vector-radian-normal a b)", "Returns a two-element list containing angle in radians and the normal from RadBetweenVectors."},
{"matrix-transpose", "(matrix-transpose matrix-value)", "Returns the transposed matrix."},
{"matrix-invert", "(matrix-invert matrix-value)", "Returns the inverse matrix. Supply an invertible matrix."},
{"matrix-calculate-dmat", "(matrix-calculate-dmat from to)", "Calls CalculateDmat4 to produce the native delta transform between two matrices."},
{"matrix-interpolate-rotate", "(matrix-interpolate-rotate from to fraction)", "Interpolates rotation using the native delta-angle/axis path. Keeps the starting translation; fraction is not clamped."},
{"matrix-decompose-to-translate", "(matrix-decompose-to-translate matrix-value)", "Returns the matrix's translation column as a vector."},
{"matrix-decompose-to-rotate", "(matrix-decompose-to-rotate matrix-value)", "Returns the matrix with translation removed. This operation does not independently remove scale."},
{"matrix-decompose-to-euler", "(matrix-decompose-to-euler matrix-value)", "Returns the Euler-angle vector produced by DecomposeRotateMatrixEuler."},
{"matrix-decompose-to-radian-normal", "(matrix-decompose-to-radian-normal matrix-value)", "Returns a two-element list of rotation radians and axis normal."},
{"matrix-look-at", "(matrix-look-at from target [up])", "Builds a transform at from with its native Z axis directed toward target. up defaults to world +Z. Avoid coincident points/degenerate axes."},
{"matrix-tilt-upright", "(matrix-tilt-upright matrix-value)", "Uses TiltMatUpright on the rotation while preserving translation."},
{"clq-evaluate", "(clq-evaluate coefficients x)", "Evaluates g0 + x * (g1 + x * g2) and returns a float."},
{"clq-evaluate-lm", "(clq-evaluate-lm coefficients limits x)", "Evaluates the quadratic and clamps the result to the supplied LM limits."},
{"clq-fit", "(clq-fit at-zero at-one sample-x sample-y)", "Fits a quadratic through (0, at-zero), (1, at-one) and (sample-x, sample-y). sample-x must differ from 0 and 1 because FitClq divides by sample-x and sample-x - 1."},
{"lm-limit", "(lm-limit limits value)", "Clamps value through the native GLimitLm helper."},
{"lm-check?", "(lm-check? limits value)", "Tests value against the supplied LM using native FCheckLm."},
{"floor", "(floor value)", "Rounds downward and returns a signed integer."},
{"ceiling", "(ceiling value)", "Rounds upward and returns a signed integer."},
{"round", "(round value)", "Returns signed integer floor(value + 0.5). Negative halfway cases do not round away from zero."},
{"truncate", "(truncate value)", "Drops the fractional part toward zero and returns a signed integer."},
{"abs", "(abs value)", "Returns absolute value, retaining an integer result for integer input and float result otherwise."},
{"max", "(max first [value ...])", "Returns the original argument with the greatest float-coerced value, retaining that argument's type."},
{"min", "(min first [value ...])", "Returns the original argument with the smallest float-coerced value, retaining that argument's type."},
{"modulo", "(modulo dividend divisor)", "Returns signed-integer remainder using native integer coercion. The reference returns zero for divisor zero; use a nonzero divisor."},
{"current-time", "(current-time)", "Returns the scene's current game time as a float."},
{"schedule-callback", "(schedule-callback delay procedure [argument ...])", "Queues a procedure and already-evaluated arguments on the world's scheduled callback list. delay is relative game time; execution is handled by the world update."},
{"defer-object-update", "(defer-object-update object delay)", "Writes the object's dtUpdatePause. Use a compatible ALO object and a game-time delay; this is not a blocking script sleep."},
{"addo", "(addo object option value)", "Adds a custom option binding to the object's sidebag. It does not invoke a native EOPID setter. Use custom IDs >= 1173; native geto takes precedence below that boundary."},
{"ensureo", "(ensureo object option value)", "Adds a sidebag binding if absent, or replaces it if present. Despite its name, it does not preserve the previous value. Use custom IDs >= 1173."},
{"seto!", "(seto! object property value)", "Changes a native property through its setter, or sets a sidebag option for IDs >= 1173. Supply the correct value type. Native method properties must instead be called through geto."},
{"geto", "(geto object property)", "Reads a native property below ID 1173, falling back to the sidebag if no descriptor is found. Method descriptors return a callable: ((geto object MethodName) arguments...). For an object list, returns the last applied result, not a list of results."},
{"find-object", "(find-object OID basis)", "Finds one object by OID using hierarchy/PROXY context. Use tag#0:0 for a null basis or an object for contextual lookup. A miss is a null object, tested with null-obj?."},
{"find-objects", "(find-objects OID basis)", "Returns up to 64 matching objects using contextual OID lookup."},
{"find-nearest-object", "(find-nearest-object OID basis)", "Uses the native nearest-object lookup flags and supplied basis to find one matching OID."},
{"find-nearest-objects", "(find-nearest-objects OID basis)", "Uses nearest-object lookup flags and returns up to 64 matching objects."},
{"find-player-object", "(find-player-object)", "Returns the current player from PpoCur, or a null object when unavailable."},
{"find-world-object", "(find-world-object)", "Returns the current SW world object."},
{"find-camera-object", "(find-camera-object)", "Returns the current camera object."},
{"find-class-objects", "(find-class-objects CID basis)", "Returns up to 256 objects through the native class search. CID is a numeric class ID; basis controls contextual lookup."},
{"find-objects-in-bounding-box", "(find-objects-in-bounding-box corner-a corner-b)", "Returns SO objects intersecting the supplied world-space bounding box using IntersectSwBoundingBox."},
{"find-objects-in-bounding-sphere", "(find-objects-in-bounding-sphere center radius)", "Returns SO objects intersecting a world-space bounding sphere."},
{"hit-test-objects", "(hit-test-objects objects start end)", "Line-tests SO objects in the supplied list. Returns hit records, each containing object and two hit positions; no hits yields None."},
{"hit-test-objects-first", "(hit-test-objects-first objects start end)", "Returns (object hit-position) for the first successful object in input-list order. It does not sort all hits by distance."},
{"convert-object-position", "(convert-object-position from-object to-object position)", "Converts a position between ALO coordinate systems through ConvertAloPos; translation participates."},
{"convert-object-vector", "(convert-object-vector from-object to-object vector-value)", "Converts a direction/vector between ALO coordinate systems through ConvertAloVec."},
{"convert-object-matrix", "(convert-object-matrix from-object to-object matrix-value)", "Converts the rotation matrix between ALO coordinate systems through ConvertAloMat. The native helper uses a 3x3 matrix."},
{"near-clip-center", "(near-clip-center)", "Returns the camera position plus its native axis 0 times near-clip distance. Returns zero if the camera is unavailable."},
{"start-sound", "(start-sound SFXID source-object)", "Starts a sound attached to an ALO source, or a null source for no attachment. Returns the native sound handle; use only that returned value with stop-sound."},
{"stop-sound", "(stop-sound sound-handle)", "Stops the sound referenced by a native sound handle."},
{"start-rumble", "(start-rumble RUMK strength)", "Triggers the selected native rumble kind with the supplied strength."},
{"emit-smoke-cloud", "(emit-smoke-cloud position size)", "Calls StandardSmokeCloud at a world position with the supplied size."},
{"predict-animation-effect", "(predict-animation-effect ASEG time playback-rate leaf basis count APEK)", "Calls PredictAsegEffect. APEK selects position, rotation, velocity and angular-velocity outputs. Returns four corresponding sublists; unrequested outputs are None. Requires compatible ASEG/ALO objects and a nonnegative count."},
{"set-music-register", "(set-music-register index value)", "Writes an adaptive music register through SetAMRegister. Value is converted to a byte; use the native register contract for the chosen music setup."},
