// Reserved event symbols from lo.h, lo.cpp and the class dispatch sites named below.
{"Post-load [0]", "(define sym#0 (lambda ($self) true))", "PostLoLoad dispatches this after object loading. Use it for runtime initialization. Source: lo.cpp."},
{"Update [1]", "(define Update (lambda ($self $dt) true))", "ALO update dispatch supplies elapsed update time. This is a recurring event, not a one-shot timer. Source: alo.cpp."},
{"Trigger [2]", "(define Trigger (lambda ($self) true))", "Activation notification dispatched by compatible classes, including BUTTON, WARP, BARRIER, ALARM and SENSOR. It does not itself activate another object. Source: button.cpp, xform.cpp, barrier.cpp, alarm.cpp, sensor.cpp."},
{"Untrigger [3]", "(define Untrigger (lambda ($self) true))", "Deactivation notification. Compatible classes dispatch it when their native activation ends. Source: alarm.cpp, button.cpp, hide.cpp."},
{"Added [4]", "(define Added (lambda ($self) true))", "ALO notifies its script when added to the world hierarchy. Source: alo.cpp."},
{"Removed [5]", "(define Removed (lambda ($self) true))", "ALO notifies its script during removal from the world hierarchy. This notification does not remove the object by itself. Source: alo.cpp."},
{"Touch [6]", "(define Touch (lambda ($self $other) true))", "SO contact processing reports an object that begins touching this object. Native event filtering still applies. Source: so.cpp and lo.cpp."},
{"Untouch [7]", "(define Untouch (lambda ($self $other) true))", "SO contact processing reports an object that stops touching this object. Source: so.cpp."},
{"Death [8]", "(define Death (lambda ($self) true))", "Reserved death notification. Only classes/gameplay paths dispatching this symbol will run the handler; defining it does not supply death behavior. Source: lo.h / SYMEVID_OnDeath."},
{"Apply [9]", "(define Apply (lambda ($self $animation) true))", "ASEG application supplies the applied animation instance. Source: aseg.cpp."},
{"Animation frame [10]", "(define sym#10 (lambda ($self $animation $value) true))", "An authored EATYP_Splice animation event supplies the animation instance and event's splice value. This is not an unconditional callback every rendered frame. Source: asega.cpp."},
{"Retract [11]", "(define Retract (lambda ($self $root) true))", "ASEG retraction supplies the animation instance's root ALO object. Source: asega.cpp."},
{"Contents changed [12]", "(define sym#12 (lambda ($self) true))", "Volume-button logic dispatches this when tracked contents change. Source: button.cpp."},
{"Fire [13]", "(define Fire (lambda ($self $projectile) true))", "Weapon firing paths pass the fired projectile/object. The exact object class depends on the weapon. Source: dartgun.cpp and rwm.cpp."},
{"Enter state [14]", "(define sym#14 (lambda ($self $instance $fromOID $toOID) true))", "SM state transition supplies SMA instance, previous-state OID and new-state OID. Source: sm.cpp."},
{"Enter StepGuard state [15]", "(define sym#15 (lambda ($self $fromState $toState) true))", "STEPGUARD state transition supplies previous and current native SGS values. These are state enums, not object OIDs. Source: stepguard.cpp."},
{"Dialog label [16]", "(define sym#16 (lambda ($self $label) true))", "DIALOG CallSplice events supply the authored label OID. Source: dialog.cpp."},
{"Apply state machine [17]", "(define sym#17 (lambda ($self $instance) true))", "SM application supplies its SMA instance. Source: sm.cpp."},
{"Retract state machine [18]", "(define sym#18 (lambda ($self) true))", "SM retraction notification. Source: sm.cpp."},
{"Basket damage [19]", "(define sym#19 (lambda ($self $damage) true))", "Basket/zap interaction forwards the damage interaction argument. Treat this as a class-specific payload, not an arbitrary numeric amount. Source: stepzap.cpp."},
{"Break damage [20]", "(define sym#20 (lambda ($self $hits) true))", "BREAK hit processing supplies its accumulated hit count after incrementing it. Source: break.cpp."},
{"Retract dialog [21]", "(define sym#21 (lambda ($self) true))", "DIALOG retraction notification. Source: dialog.cpp."},
{"Restore [22]", "(define Restore (lambda ($self) true))", "Compatible ALARM, BREAK and button logic dispatch a restore/reset notification. It does not automatically restore unrelated objects. Source: alarm.cpp, break.cpp, button.cpp."},
{"Script apply [23]", "(define sym#23 (lambda ($self) true))", "JSG script application notification. Source: jsg.cpp."},
{"Script label [24]", "(define sym#24 (lambda ($self $label) true))", "JSG script label processing supplies the label OID. Source: jsg.cpp."},
{"Script retract [25]", "(define sym#25 (lambda ($self) true))", "JSG script retraction notification. Source: jsg.cpp."},
{"Rhythm start [26]", "(define sym#26 (lambda ($self) true))", "Rhythm-sequence start notification. Source: rythm.cpp."},
{"Rhythm event [27]", "(define sym#27 (lambda ($self $command) true))", "Rhythm sequence supplies one integer command. The native dispatcher explicitly handles this event outside the shared signature table. Source: rythm.cpp and lo.cpp."},
{"Rhythm stop [28]", "(define sym#28 (lambda ($self) true))", "Rhythm-sequence stop notification. Source: rythm.cpp."},
{"Barrier impact [29]", "(define sym#29 (lambda ($self $other) true))", "BARRIER reports the impacted SO leaf object. The same interaction also dispatches Trigger. Source: barrier.cpp and lo.cpp."},
